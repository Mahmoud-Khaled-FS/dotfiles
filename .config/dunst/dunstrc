[global]
  width = 400
  offset = (5,20)

  progress_bar_min_width = 380
  progress_bar_max_width = 380
  progress_bar_corner_radius = 2

  padding 10
  horizontal_padding 10
  frame_width 1
  gap_size = 3
  font = "Hack 14"

  // TODO (MAHMOUD) - Add icon theme with icon config

  background = "#26233a"
  foreground = "#e0def4"

[urgency_low]
  background = "#26273d"
  highlight = "#31748f"
  frame_color = "#31748f"
  format = "<b><span foreground='#31748f'>%s</span></b>\n%b"


[urgency_normal]
  background = "#362e3c"
  highlight = "#f6c177"
  frame_color = "#f6c177"
  format = "<b><span foreground='#f6c177'>%s</span></b>\n%b"

[urgency_critical]
  background = "#35263D"
  highlight = "#ed6f92"
  frame_color = "#ed6f92"
  format = "<b><span foreground='#ed6f92'>%s</span></b>\n%b"